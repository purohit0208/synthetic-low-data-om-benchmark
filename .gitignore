# Local Python artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*

# Local logs and temporary outputs
*.log
*.tmp
tmp/
temp/

# Model/download caches
.cache/
huggingface/
hf_cache/
models/

# Literature review materials are local evidence/discovery artifacts.
# Do not publish Consensus reports, extracted report text, or downloaded papers.
literature_review/

# Manuscript/submission artifacts are tracked when intentionally prepared.
# Keep only transient render/extraction artifacts local.
manuscript/__pycache__/
manuscript/docx_images/
manuscript/render_qa_*/
manuscript/*.extracted.txt
submission/**/pdf_check*/
submission/**/render_*/
submission/**/*.extracted.txt
~$*.docx

# Simulator internals are useful for local audit but are not model inputs.
outputs/latent_database.parquet

# Operating system metadata
Thumbs.db
.DS_Store
